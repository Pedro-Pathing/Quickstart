    // ---- Added for biobuzz: Math.clamp (JDK 21) has no contract in OpenJML's specs. Written from
    // the JDK 21 javadoc: NaN value gives NaN; -0.0 is treated as below +0.0; it throws
    // IllegalArgumentException if a bound is NaN, min > max, or min is +0.0 and max is -0.0.
    /*@ public normal_behavior
      @   requires !Double.isNaN(min) && !Double.isNaN(max) && min <= max;
      @   requires !(isPositiveZero(min) && isNegativeZero(max));
      @   {|
      @     requires Double.isNaN(value);
      @     ensures Double.isNaN(\result);
      @   also
      @     requires !Double.isNaN(value);
      @     ensures min <= \result && \result <= max;
      @     ensures (min <= value && value <= max) ==> \result == value;
      @     ensures value < min ==> \result == min;
      @     ensures value > max ==> \result == max;
      @   |}
      @ also public exceptional_behavior
      @   requires Double.isNaN(min) || Double.isNaN(max) || min > max
      @         || (isPositiveZero(min) && isNegativeZero(max));
      @   signals_only IllegalArgumentException;
      @*/
    public static /*@ no_state @*/ double clamp(double value, double min, double max);
}
